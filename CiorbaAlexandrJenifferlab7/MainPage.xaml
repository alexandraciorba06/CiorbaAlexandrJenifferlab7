<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CiorbaAlexandrJenifferlab7.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <!-- Imagine personalizată -->
            <Image
                Source="shop_list.jpg"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Imagine personalizata pentru pagina mea" />

            <!-- Text personalizat -->
            <Label
                Text="Salut! Eu sunt Ciorba Alexandr Jeniffer"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Aceasta este pagina mea personalizată pentru laboratorul 7 la MAUI."
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                HorizontalTextAlignment="Center"
                SemanticProperties.Description="Text personalizat pentru laborator" />

            <!-- Optional: păstrez butonul din proiectul original -->
            <Button
                x:Name="CounterBtn"
                Text="Click me"
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>